{
  "name": "voxel-dragon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dragon/playground",
    "dev:portfolio": "npm run dev -w @dragon/portfolio-example",
    "build": "npm run build -w @dragon/playground && npm run build -w @dragon/portfolio-example",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "types": "tsc -p packages/voxel-scene/tsconfig.types.json",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@react-three/drei": "10.7",
    "@react-three/fiber": "9.8",
    "@react-three/postprocessing": "3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "leva": "^0.10.1",
    "postprocessing": "^6.39.5",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
